SERVER_HOST=localhost
SERVER_PORT=8082
SERVER_TIMEOUT=4s
SERVER_IDLETIMEOUT=60s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myDB
DB_SSLMODE=disable
DB_MAXCONNS=10
DB_MINCONNS=2
DB_MAXCONNLIFETIME=1h
DB_MAXCONNIDLETIME=30m
DB_HEALTHCHECKPERIOD=1m

JWT_SECRET=filler
JWT_ACCESSEXP=1h
JWT_REFRESHEXP=24h

ENV=local
LOGGER_LEVEL=info
LOGGER_CONSOLE_ENABLED=true
LOGGER_CONSOLE_FORMAT=text
LOGGER_CONSOLE_OUTPUT=stdout
LOGGER_FILE_ENABLED=false
LOGGER_FILE_FORMAT=json
LOGGER_FILE_PATH=./app.log

